---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="404" description="Page not found / Страница не найдена" locale="ru">
  <main class="container section" id="main">
    <h1>404</h1>
    <p>Страница не найдена / Page not found.</p>
    <p><a href={base}>На главную</a> · <a href={base + 'en/'}>English version</a></p>
  </main>
</Base>
