---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';

const entry = await getEntry('profile', 'ru');
if (!entry) throw new Error('profile ru not found');
const profile = entry.data;
---

<Base title={`${profile.name} — ${profile.title}`} description={profile.summary} locale="ru">
  <Home profile={profile} locale="ru" />
</Base>
