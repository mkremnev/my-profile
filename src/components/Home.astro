---
import type { Profile } from '../content/schema';
import { t, type Locale } from '../i18n/ui';
import Contacts from './Contacts.astro';
import LangToggle from './LangToggle.astro';
import ProfileCardIsland from './ProfileCardIsland';
import SkillList from './SkillList.astro';
import SoftSkills from './SoftSkills.astro';

interface Props {
  profile: Profile;
  locale: Locale;
}

const { profile, locale } = Astro.props;
const email = profile.contacts.find((c) => c.type === 'email')?.url.replace('mailto:', '');
const telegram = profile.contacts.find((c) => c.type === 'telegram')?.url;
---

<LangToggle locale={locale} />
<main id="main">
  <section class="hero container" aria-label={profile.name}>
    <ProfileCardIsland
      client:visible
      profile={profile}
      contactText={t(locale, 'card.contact')}
      email={email}
      telegram={telegram}
    />
    <p class="hero__summary">{profile.summary}</p>
  </section>
  <Contacts contacts={profile.contacts} locale={locale} />
  <SkillList skills={profile.hardSkills} locale={locale} />
  <SoftSkills skills={profile.softSkills} locale={locale} />
</main>

<style>
  main {
    padding-bottom: var(--space-16);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(280px, 360px) 1fr;
    align-items: center;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
    padding-block: clamp(var(--space-12), 10vh, var(--space-16));
  }

  .hero__summary {
    max-width: 30ch;
    margin: 0;
    color: var(--color-text);
    font-size: clamp(var(--text-lg), 2.2vw, var(--text-2xl));
    line-height: 1.5;
    text-wrap: balance;
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .hero__summary {
      max-width: 34ch;
    }
  }
</style>
